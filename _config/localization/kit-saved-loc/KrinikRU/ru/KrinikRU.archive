   },
   "Key": "Ancient_Civ_ItemTable3790335_LongDesc"
  },
  {
   "Source": {
    "Text": "Insulated"
   },
   "Translation": {
    "Text": "С защитой"
   },
   "Key": "Ancient_Civ_ItemTable3790335_FirstModifier"
  },
  {
   "Source": {
    "Text": "Ancient Civ Gateway (3x3)"
   },
   "Translation": {
    "Text": "Древний воротный проем (3x3)"
   },
   "Key": "Ancient_Civ_ItemTable3790333_Name"
  },
  {
   "Source": {
    "Text": "Framework for a large gate"
   },
   "Translation": {
    "Text": "Конструкция для крепления больших ворот"
   },
   "Key": "Ancient_Civ_ItemTable3790333_ShortDesc"
  },
  {
   "Source": {
