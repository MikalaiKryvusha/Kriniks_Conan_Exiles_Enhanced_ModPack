  {
   "Source": {
    "Text": "Weapon"
   },
   "Translation": {
    "Text": "Оружие"
   },
   "Key": "HA_ItemTable_2491992_SecondModifier"
  },
  {
   "Source": {
    "Text": "Withering Strikes (+2)"
