   },
   "Translation": {
    "Text": "Сортировка: доспехи"
   },
   "Key": "SB_RecipyTable_909090905_RecipeName"
  },
  {
   "Source": {
    "Text": "Allows chest to take all armour from the sorting chest"
   },
