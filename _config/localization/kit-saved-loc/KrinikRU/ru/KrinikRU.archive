  },
  {
   "Source": {
    "Text": "Relax"
   },
   "Translation": {
    "Text": "Расслабиться"
   },
   "Key": "69FCB72A436F1A99EB4EC89550B1F987"
  },
  {
   "Source": {
    "Text": "sets your pet to relax in its bed"
   },
   "Translation": {
    "Text": "Питомец отдыхает на своей лежанке"
