   },
   "Key": "ODO_ItemTable_Add_47210119_SecondModifier"
  },
  {
   "Source": {
    "Text": "Persistent Light Source"
   },
   "Translation": {
    "Text": "Долгий источник света"
   },
   "Key": "ODO_ItemTable_Add_47210119_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Feast of Set "
   },
   "Translation": {
    "Text": "Трапеза Сета"
   },
