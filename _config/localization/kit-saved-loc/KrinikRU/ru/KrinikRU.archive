   },
   "Key": "HA_ItemTable_2491734_SecondModifier"
  },
  {
   "Source": {
    "Text": "Charged Finishers"
   },
   "Translation": {
    "Text": "Заряженные добивания"
   },
   "Key": "HA_ItemTable_2491734_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Energizing Assault"
   },
   "Translation": {
    "Text": "Бодрящий натиск"
   },
   "Key": "HA_ItemTable_2491734_FourthModifier"
  },
  {
   "Source": {
    "Text": "Cindershot Gunblade"
   },
   "Translation": {
    "Text": "Клинок-ружье «Пеплострел»"
   },
   "Key": "HA_ItemTable_2491735_Name"
  },
  {
   "Source": {
    "Text": "A longsword, with an attached scattergun underneath"
   },
