  },
  {
   "Source": {
    "Text": "Set to \r\n1 Letter per Reset"
   },
   "Translation": {
    "Text": "Задано:\r\n1 письмо за сброс"
   },
   "Key": "8B79757D4A4DEDC932AD80876A024618"
  },
  {
