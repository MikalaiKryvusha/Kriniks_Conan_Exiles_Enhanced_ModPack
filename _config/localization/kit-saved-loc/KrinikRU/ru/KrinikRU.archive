   },
   "Translation": {
    "Text": "Урон оружия для проворных +{0}%"
   },
   "Key": "DT_Fishing_ItemTable_389340_SecondModifier"
  },
  {
   "Source": {
    "Text": "Follower Damage +{0}%"
   },
   "Translation": {
    "Text": "Урон спутника +{0}%"
   },
   "Key": "DT_Fishing_ItemTable_389340_ThirdModifier"
  },
  {
