  },
  {
   "Source": {
    "Text": "Common Flintlock Decoration"
   },
   "Translation": {
    "Text": "Простой кремневый пистолет (декор)"
   },
   "Key": "HA_ItemTable_2490408_Name"
  },
  {
   "Source": {
    "Text": "Placable"
   },
   "Translation": {
    "Text": "Размещаемый предмет"
   },
   "Key": "HA_ItemTable_2490408_ShortDesc"
  },
  {
   "Source": {
    "Text": "Brood Poison"
   },
   "Translation": {
    "Text": "Яд выводка"
   },
   "Key": "HA_ItemTable_2491351_Name"
  },
  {
   "Source": {
    "Text": "A stacking, slow, high damage poison that can be applied to weapons"
   },
   "Translation": {
    "Text": "Медленный яд для оружия: наносит большой урон и копит заряды"
   },
   "Key": "HA_ItemTable_2491351_ShortDesc"
  },
  {
   "Source": {
    "Text": "A higher damaging variant of Scorpion Queen Poison. Deals 2 damage per stack once every second, with an additional 1.5x multiplier per stack. Stacks to 10, lasts 10 seconds, and can be cleansed."
   },
   "Translation": {
    "Text": "Более сильный вариант яда Королевы скорпионов. Раз в секунду наносит 2 урона за каждый заряд, и каждый заряд добавляет множитель x1,5. До 10 зарядов, действует 10 секунд, можно снять очищением."
   },
   "Key": "HA_ItemTable_2491351_LongDesc"
  },
  {
   "Source": {
    "Text": "Stacking (10)"
   },
   "Translation": {
    "Text": "Копит заряды (10)"
   },
   "Key": "HA_ItemTable_2491351_FirstModifier"
  },
  {
   "Source": {
    "Text": "DPS: 4 to 51"
   },
   "Translation": {
    "Text": "Урон в секунду: от 4 до 51"
   },
   "Key": "HA_ItemTable_2491351_SecondModifier"
  },
  {
   "Source": {
    "Text": "Duration: 10s"
   },
   "Translation": {
    "Text": "Длительность: 10 с"
   },
   "Key": "HA_ItemTable_2491351_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Poison Debuff"
   },
   "Translation": {
    "Text": "Ослабление: отравление"
   },
   "Key": "HA_ItemTable_2491351_FourthModifier"
  },
  {
   "Source": {
    "Text": "Simple Furnace"
   },
   "Translation": {
    "Text": "Простая печь"
   },
   "Key": "HA_ItemTable_2490410_Name"
  },
  {
   "Source": {
    "Text": "Placable, can be turned on/off"
   },
   "Translation": {
    "Text": "Размещаемый предмет, включается и выключается"
   },
   "Key": "HA_ItemTable_2490410_ShortDesc"
