   },
   "Key": "Ancient_Civ_RecipesTable3780837_RecipeName"
  },
  {
   "Source": {
    "Text": "A dark mineshaft"
   },
   "Translation": {
    "Text": "Темная шахта"
   },
   "Key": "Ancient_Civ_RecipesTable3780837_ShortDesc"
  },
  {
   "Source": {
    "Text": "Ancient Civ Construction Site"
   },
   "Translation": {
    "Text": "Древняя стройплощадка"
   },
   "Key": "Ancient_Civ_RecipesTable3780836_RecipeName"
  },
  {
   "Source": {
    "Text": "A building site for crafting construction elements"
   },
   "Translation": {
    "Text": "Стройплощадка, на которой делают строительные блоки"
   },
   "Key": "Ancient_Civ_RecipesTable3780836_ShortDesc"
  },
  {
   "Source": {
    "Text": "Ancient Civ Crane"
   },
   "Translation": {
    "Text": "Древний подъемный кран"
   },
   "Key": "Ancient_Civ_RecipesTable3780799_RecipeName"
  },
  {
   "Source": {
    "Text": "A useful crane for building construction elements"
   },
   "Translation": {
    "Text": "Подъемный кран, без которого не построить крупные блоки"
   },
   "Key": "Ancient_Civ_RecipesTable3780799_ShortDesc"
  },
  {
   "Source": {
    "Text": "Ancient Civ Mineshaft"
   },
   "Translation": {
    "Text": "Древняя шахта"
   },
   "Key": "Ancient_Civ_RecipesTable3780842_RecipeName"
