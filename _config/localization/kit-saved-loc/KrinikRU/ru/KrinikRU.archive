   },
   "Key": "HA_ItemTable_2491849_SecondModifier"
  },
  {
   "Source": {
    "Text": "Charged Finishers"
   },
   "Translation": {
    "Text": "Заряженные добивания"
   },
   "Key": "HA_ItemTable_2491849_ThirdModifier"
  },
  {
   "Source": {
