  },
  {
   "Source": {
    "Text": "Rough gauntlets worn by Yoggite devotees."
   },
   "Translation": {
    "Text": "Грубые рукавицы последователей Йога."
   },
   "Key": "CBF40347476F67CE4E1F9CA275F73860"
  },
