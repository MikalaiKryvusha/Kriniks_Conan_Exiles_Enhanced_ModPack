   },
   "Translation": {
    "Text": "Лютое касание"
   },
   "Key": "HA_ItemTable_2492107_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Plagued Strikes (+3)"
   },
   "Translation": {
    "Text": "Чумные удары (+3)"
   },
   "Key": "HA_ItemTable_2492107_FourthModifier"
  },
  {
