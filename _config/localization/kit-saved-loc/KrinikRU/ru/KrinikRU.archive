  },
  {
   "Source": {
    "Text": "Map"
   },
   "Translation": {
    "Text": "Карта"
   },
   "Key": "Core_ItemTable_210136_Name"
  },
  {
   "Source": {
    "Text": "A Map of the Exiled Lands"
   },
   "Translation": {
    "Text": "Карта Земель изгнанников"
   },
   "Key": "Core_ItemTable_210136_ShortDesc"
  },
  {
   "Source": {
    "Text": "A map is a symbolic depiction emphasizing relationships between elements of some space, such as objects, regions, or themes."
   },
   "Translation": {
    "Text": "Карта — условное изображение, которое показывает связи между частями пространства: предметами, областями или темами."
   },
   "Key": "Core_ItemTable_210136_LongDesc"
  },
  {
   "Source": {
    "Text": "Map"
   },
   "Translation": {
    "Text": "Карта"
   },
   "Key": "Core_ItemTable_210137_Name"
