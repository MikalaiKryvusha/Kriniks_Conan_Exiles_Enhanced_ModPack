  },
  {
   "Source": {
    "Text": "Reforged Setite Scale-Skirt"
   },
   "Translation": {
    "Text": "Перекованная чешуйчатая юбка сетита"
   },
   "Key": "EoT_ItemTable_Add_47210187_Name"
  },
  {
