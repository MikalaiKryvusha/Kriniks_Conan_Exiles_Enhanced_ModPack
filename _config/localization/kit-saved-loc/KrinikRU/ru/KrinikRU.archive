   },
   "Key": "Ancient_Civ_ItemTable3790331_Name"
  },
  {
   "Source": {
    "Text": "A low fence made of iron"
   },
   "Translation": {
    "Text": "Низкая ограда из железа"
   },
   "Key": "Ancient_Civ_ItemTable3790331_ShortDesc"
  },
  {
   "Source": {
