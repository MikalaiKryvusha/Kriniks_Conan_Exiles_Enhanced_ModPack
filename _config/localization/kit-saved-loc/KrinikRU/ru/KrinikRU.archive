  {
   "Source": {
    "Text": "Enhanced Armory & Arsenal"
   },
   "Translation": {
    "Text": "Enhanced Armory & Arsenal"
   },
   "Key": "DT_EAA_Itemtable_5545888_FirstModifier"
  },
  {
   "Source": {
    "Text": "Wartorn"
   },
