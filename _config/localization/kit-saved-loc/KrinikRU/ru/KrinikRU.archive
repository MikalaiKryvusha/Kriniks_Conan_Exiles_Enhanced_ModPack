   },
   "Translation": {
    "Text": "Шлем-шапель"
   },
   "Key": "HA_ItemTable_2490046_Name"
  },
  {
   "Source": {
    "Text": "A piece of armor made to protect"
   },
   "Translation": {
    "Text": "Доспех для защиты"
   },
   "Key": "HA_ItemTable_2490046_ShortDesc"
  },
  {
   "Source": {
    "Text": "Legendary"
   },
   "Translation": {
    "Text": "Прославленный"
   },
