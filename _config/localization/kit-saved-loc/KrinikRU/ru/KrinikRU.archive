   },
   "Key": "68059A354AD5FDF185E06AB7548D26EA"
  },
  {
   "Source": {
    "Text": "Goblet 3"
   },
   "Translation": {
    "Text": "Кубок 3"
   },
   "Key": "C16CFF2545A5B79CC75F42A3DC9638D7"
  },
  {
