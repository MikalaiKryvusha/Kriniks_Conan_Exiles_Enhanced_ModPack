   },
   "Key": "HA_ItemTable_2491339_ThirdModifier"
  },
  {
   "Source": {
    "Text": "(HA) Powerful Healing Flask"
   },
   "Translation": {
    "Text": "(HA) Мощная целебная склянка"
   },
   "Key": "HA_ItemTable_2491340_Name"
  },
  {
   "Source": {
