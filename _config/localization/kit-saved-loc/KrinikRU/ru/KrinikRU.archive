   },
   "Key": "08A77270421D3363A6991BB40F635EE1"
  },
  {
   "Source": {
    "Text": "Boar Shoats"
   },
   "Translation": {
    "Text": "Детеныши вепря"
   },
   "Key": "CD3BB2B24B04F28400A522A327D906EC"
  },
  {
   "Source": {
    "Text": "Camel Calves"
   },
   "Translation": {
    "Text": "Верблюжата"
   },
   "Key": "5CD6BD54448579F711F9A29C8611F207"
  },
  {
   "Source": {
    "Text": "Crested Lacerta Hatchlings"
   },
   "Translation": {
    "Text": "Детеныши хохлатой ящерицы"
   },
   "Key": "01142F9B4A0AE396DAD3D1A7750D22C6"
