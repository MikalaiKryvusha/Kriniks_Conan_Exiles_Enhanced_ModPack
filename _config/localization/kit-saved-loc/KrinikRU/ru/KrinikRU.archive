   },
   "Key": "E5A17ADC480D38CE97E00A8325AC761D"
  },
  {
   "Source": {
    "Text": "Enhanced Armory & Arsenal Enchanting"
   },
   "Translation": {
    "Text": "Enhanced Armory & Arsenal: зачарование"
   },
   "Key": "A1519FC347B8874BDD8A088EE6D2590E"
  },
  {
   "Source": {
    "Text": "Enchant Ring Darkstar"
   },
   "Translation": {
    "Text": "Зачаровать кольцо «Темная звезда»"
   },
   "Key": "E267BFC74B3D9452D392659CAC209AA9"
  },
  {
