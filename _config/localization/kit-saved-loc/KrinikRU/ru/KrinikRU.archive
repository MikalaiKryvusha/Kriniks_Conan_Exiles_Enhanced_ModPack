   },
   "Key": "HA_ItemTable_2490398_SecondModifier"
  },
  {
   "Source": {
    "Text": "Light"
   },
   "Translation": {
    "Text": "Легкий"
   },
   "Key": "HA_ItemTable_2490398_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Preserved Feast"
   },
   "Translation": {
    "Text": "Непортящийся пир"
   },
   "Key": "HA_ItemTable_2490397_Name"
  },
  {
   "Source": {
    "Text": "A delicious meal that heals stamina and health and won't perish"
   },
   "Translation": {
    "Text": "Вкусное блюдо: восстанавливает запас сил и здоровье и не портится"
   },
   "Key": "HA_ItemTable_2490397_ShortDesc"
  },
  {
   "Source": {
    "Text": "Epic"
   },
   "Translation": {
    "Text": "Эпическая"
   },
   "Key": "HA_ItemTable_2490397_FirstModifier"
  },
  {
   "Source": {
    "Text": "Food"
   },
   "Translation": {
    "Text": "Еда"
   },
   "Key": "HA_ItemTable_2490397_SecondModifier"
  },
  {
   "Source": {
    "Text": "Improved Stamina Recovery"
   },
