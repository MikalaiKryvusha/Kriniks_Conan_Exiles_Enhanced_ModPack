   },
   "Translation": {
    "Text": "(HA) Сфера эмоции (калифорнийский танец)"
   },
   "Key": "HA_ItemTable_2491204_Name"
  },
  {
   "Source": {
    "Text": "A reusable item to express yourself"
   },
   "Translation": {
    "Text": "Многоразовый предмет для самовыражения"
   },
   "Key": "HA_ItemTable_2491204_ShortDesc"
  },
  {
   "Source": {
    "Text": "Developer"
   },
   "Translation": {
    "Text": "Для разработчика"
   },
   "Key": "HA_ItemTable_2491204_FirstModifier"
  },
