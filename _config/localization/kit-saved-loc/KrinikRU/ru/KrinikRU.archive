   },
   "Key": "HA_ItemTable_2491024_SecondModifier"
  },
  {
   "Source": {
    "Text": "(HA) Storyteller's Crown - 20 Strength"
   },
   "Translation": {
    "Text": "(HA) Корона сказителя: 20 силы"
   },
   "Key": "HA_ItemTable_2491023_Name"
  },
  {
   "Source": {
