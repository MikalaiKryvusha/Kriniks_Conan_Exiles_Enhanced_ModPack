   },
   "Key": "ODO_ItemTable_Merge_18212_Name"
  },
  {
   "Source": {
    "Text": "A ritualistic meal in honor of Yog"
   },
   "Translation": {
    "Text": "Ритуальное блюдо во славу Йога."
   },
   "Key": "ODO_ItemTable_Merge_18212_ShortDesc"
  },
  {
   "Source": {
    "Text": "Feast"
   },
   "Translation": {
    "Text": "Пир"
   },
   "Key": "ODO_ItemTable_Add_18212_FirstModifier"
  },
  {
   "Source": {
    "Text": "Stamina Regen"
   },
   "Translation": {
    "Text": "Восстановление запаса сил"
   },
   "Key": "ODO_ItemTable_Add_18212_SecondModifier"
  },
  {
   "Source": {
    "Text": "Dark Satiety"
   },
   "Translation": {
    "Text": "Тёмная сытость"
   },
   "Key": "ODO_ItemTable_Add_18212_ThirdModifier"
  },
  {
   "Source": {
    "Text": "[DEP] Yoggite Tool Upgrade Kit"
   },
   "Translation": {
    "Text": "[устар.] Набор улучшения инструментов йоггита"
   },
   "Key": "ODO_ItemTable_Add_47210125_Name"
  },
