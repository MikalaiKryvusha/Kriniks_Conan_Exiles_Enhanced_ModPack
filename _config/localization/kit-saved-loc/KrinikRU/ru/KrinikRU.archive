   "Key": "Core_ItemTable_210005_ShortDesc"
  },
  {
   "Source": {
    "Text": "A simple plate for holding or preparing food."
   },
   "Translation": {
    "Text": "Простая тарелка для хранения и приготовления еды."
   },
   "Key": "Core_ItemTable_210005_LongDesc"
  },
  {
   "Source": {
    "Text": "Wooden Serving Bowl"
   },
