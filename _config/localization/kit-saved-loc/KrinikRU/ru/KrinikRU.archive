  },
  {
   "Source": {
    "Text": "Black Centurion Helm"
   },
   "Translation": {
    "Text": "Шлем черного центуриона"
   },
   "Key": "HA_ItemTable_2491866_Name"
  },
  {
   "Source": {
    "Text": "A piece of armor made to protect"
   },
   "Translation": {
    "Text": "Доспех для защиты"
   },
   "Key": "HA_ItemTable_2491866_ShortDesc"
  },
  {
   "Source": {
    "Text": "Belonged to a leader in a vast army. They charged into battle and were swallowed up by the enemy. Abandoned and left to die. Do not put all your trust into men whose hearts are selfish. Commissioned by JimothyJamothy."
   },
   "Translation": {
    "Text": "Принадлежал полководцу огромной армии. Он повел своих в бой, и враг поглотил их. Брошенный, оставленный умирать... Не доверяйся целиком тем, чьи сердца себялюбивы. Сделано по заказу JimothyJamothy."
   },
   "Key": "HA_ItemTable_2491866_LongDesc"
  },
  {
   "Source": {
    "Text": "Epic"
   },
   "Translation": {
    "Text": "Эпическая"
   },
   "Key": "HA_ItemTable_2491866_FirstModifier"
  },
  {
   "Source": {
    "Text": "Armor"
   },
   "Translation": {
    "Text": "Доспехи"
   },
   "Key": "HA_ItemTable_2491866_SecondModifier"
  },
  {
   "Source": {
    "Text": "Light"
   },
   "Translation": {
    "Text": "Легкий"
   },
   "Key": "HA_ItemTable_2491866_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Crusader Kite Shield"
   },
   "Translation": {
    "Text": "Каплевидный щит крестоносца"
   },
   "Key": "HA_ItemTable_2491867_Name"
  },
  {
   "Source": {
    "Text": "A kite shield with an insignia"
   },
   "Translation": {
    "Text": "Каплевидный щит с гербом"
   },
   "Key": "HA_ItemTable_2491867_ShortDesc"
  },
  {
   "Source": {
    "Text": "Commissioned by JimothyJamothy."
