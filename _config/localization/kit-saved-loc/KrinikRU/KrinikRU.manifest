     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "A two-handed lightweight blade that inflicts Cursed"
   },
   "Keys": [
    {
     "Key": "HA_ItemTable_2491755_ShortDesc",
     "Path": ""
    }
   ]
  },
