  {
   "Source": {
    "Text": "Aesirian Pick"
   },
   "Keys": [
    {
     "Key": "ItemTable_Ymirs_Respite_77012409_Name",
     "Path": ""
    },
    {
     "Key": "RecipesTable_Ymirs_Respite_770124207_RecipeName",
