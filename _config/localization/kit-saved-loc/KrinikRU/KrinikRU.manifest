  {
   "Source": {
    "Text": "Amantia Shroom Spores"
   },
   "Keys": [
    {
     "Key": "dt_Horti_ItemTableRow_5100091_Name",
     "Path": ""
    },
    {
     "Key": "dt_Horti_recipetablerow_5100091_RecipeName",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Spores for planting mushrooms"
   },
   "Keys": [
    {
     "Key": "dt_Horti_ItemTableRow_5100091_ShortDesc",
     "Path": ""
    },
    {
