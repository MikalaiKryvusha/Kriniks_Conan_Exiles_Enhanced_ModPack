     "Key": "Caverns_of_Set_Item_Table_77991106_FifthModifier",
     "Path": ""
    },
    {
     "Key": "Caverns_of_Set_Item_Table_77991107_FifthModifier",
     "Path": ""
    },
    {
     "Key": "Caverns_of_Set_Item_Table_77991108_FifthModifier",
     "Path": ""
    },
    {
     "Key": "Caverns_of_Set_Item_Table_77991109_FifthModifier",
     "Path": ""
    },
    {
