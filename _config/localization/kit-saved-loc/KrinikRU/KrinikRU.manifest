  },
  {
   "Source": {
    "Text": "An ornate choker worn by Setite devotees."
   },
   "Keys": [
    {
     "Key": "ODO_ItemTable_Add_52502_ShortDesc",
     "Path": ""
    },
    {
     "Key": "EoT_ItemTable_Add_47210190_ShortDesc",
