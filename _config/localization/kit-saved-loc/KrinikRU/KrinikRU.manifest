    "Text": "A storage hub a hauler thrall docks at"
   },
   "Keys": [
    {
     "Key": "RecipesTable_999117_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Patrol Order"
   },
   "Keys": [
    {
     "Key": "RecipesTable_999107_RecipeName",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Hanging Patrol Node"
   },
   "Keys": [
    {
     "Key": "RecipesTable_999108_RecipeName",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Waypoint for patrol routes"
   },
   "Keys": [
    {
     "Key": "RecipesTable_999108_ShortDesc",
     "Path": ""
    }
   ]
  },
