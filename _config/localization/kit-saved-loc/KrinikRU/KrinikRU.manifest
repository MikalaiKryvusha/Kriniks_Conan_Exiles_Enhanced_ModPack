   },
   "Keys": [
    {
     "Key": "HA_ItemTable_2492160_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "(HA) Unrestricted Balanced Weapon Scaling Modkit"
   },
   "Keys": [
    {
     "Key": "HA_ItemTable_2492161_Name",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Drag a weapon onto this to change the scaling to favor both attributes evenly"
   },
   "Keys": [
    {
     "Key": "HA_ItemTable_2492161_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Item is removed when another item is dropped onto it. This item functions by changing the weapon's primary attribute scaling multiplier (which is usually Strength) to 55%, and the secondary scaling attribute multiplier (which is usually Agility) to 55%."
   },
   "Keys": [
    {
     "Key": "HA_ItemTable_2492161_LongDesc",
     "Path": ""
    }
   ]
  },
