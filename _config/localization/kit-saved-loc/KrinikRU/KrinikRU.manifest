  {
   "Source": {
    "Text": "Crown of the Sun Platter"
   },
   "Keys": [
    {
     "Key": "DT_Fishing_ItemTable_389333_Name",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "A shared platter from the high desert. Lasts 20 minutes when placed."
   },
   "Keys": [
    {
     "Key": "DT_Fishing_ItemTable_389333_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Laid out like an offering to a merciless sun, this platter gathers rich fish, bronze spice, and hard-won desert craft. It is made for warriors to take strength before the heat takes them."
   },
   "Keys": [
    {
     "Key": "DT_Fishing_ItemTable_389333_LongDesc",
     "Path": ""
    }
   ]
  },
