  {
   "Source": {
    "Text": "Zamorian Dancer Blouse"
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483020_Name",
     "Path": ""
    },
    {
     "Key": "dt_Recipe_Table_147483020_RecipeName",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "A blouse favored by Zamorian temple dancers"
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483020_ShortDesc",
     "Path": ""
    },
    {
     "Key": "dt_Recipe_Table_147483020_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Zamorians are known far and wide for the depth of their wickedness and thievery, but very few speak of the prowess of the temple dancers.\nThe steps of the dance are unknown, but it is clear that it eases the black madness that whispers to those who find themselves in the vicinity of the awful presence of Zath, spider-god of Yezud.\n\nFor ceremonial usage, this blouse offers very little protection against sword or fang, but offers slight relief from cold, heat and stinging sand."
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483020_LongDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Zamorian Dancer Bracelets"
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483023_Name",
     "Path": ""
    },
    {
     "Key": "dt_Recipe_Table_147483023_RecipeName",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Bracelets favored by the temple dancers of Zamoria"
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483023_ShortDesc",
     "Path": ""
    },
    {
     "Key": "dt_Recipe_Table_147483023_ShortDesc",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Zamorians are known far and wide for the depth of their wickedness and thievery, but very few speak of the prowess of the temple dancers.\nIt is whispered that the temple girls of Yezud wear clothing such as this when they dance before the black stone spider that is their god.\n\nFor ceremonial usage, this bracelet offers very little protection against sword or fang, but offers slight relief from cold, heat and stinging sand."
   },
   "Keys": [
    {
     "Key": "dt_Ma_Table_147483023_LongDesc",
     "Path": ""
    }
   ]
  },
