  },
  {
   "Source": {
    "Text": "Boss"
   },
   "Keys": [
    {
     "Key": "31E79E024701A54B443E3B8033982BA3",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Snake"
   },
   "Keys": [
    {
     "Key": "0DD795DA479F3BC1D1240CB90CEAA5B6",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "We have buried more banners than history remembers!"
   },
   "Keys": [
    {
     "Key": "ACB5D87E4206B6DCD5B2D18083AF217D",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "I am here in the name of the divine kingdom of Set!"
   },
   "Keys": [
    {
     "Key": "B0D459254AB7EF36192B61965D22F1BD",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "All that we do echoes the glory of the divine King Ctesphon. All that we do reflects on the shining scales of Set!"
   },
   "Keys": [
    {
     "Key": "8C22B12A465DC2320ABD809695DC105E",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "We are the squeezing coils of history, grinding stone and dynasty to dust! We are the serpent that swallows nations! We are empire. We are war. And when all else is consumed, we shall ascend and swallow the sun!"
   },
   "Keys": [
    {
     "Key": "8C2AC3C647ED1D0A8280618DD8572507",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Impossible! You... you do not deserve to spill my noble blood."
   },
   "Keys": [
    {
     "Key": "E02EF4E24FB74573B5CDE3AD282BE9A6",
     "Path": ""
    },
    {
     "Key": "96A673E9425ABFB40487C7900C161270",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Mongrels! Curs! Curses upon your miserable tribe of misfits. No direction... no past... no future..."
   },
   "Keys": [
    {
     "Key": "B7BA5CDC4FB547B4E88ED9B4F1FEB633",
     "Path": ""
    },
    {
     "Key": "7ABF10F64A04065F55C479B7721B2204",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "The continent crushing weight of the Stygian empire will crash down upon your heads!"
   },
   "Keys": [
    {
     "Key": "3D1C6C334116D949AD4E928CDE9AD854",
     "Path": ""
    },
    {
     "Key": "672DFF194F77FAE6D053A9AB6A6483E0",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Hahahaha! Set reserves a special place in his bowels for the soul of cowards!"
   },
   "Keys": [
    {
     "Key": "2C033F03467767343764198D898789A4",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "How dare you mongrels bark at the lords of Stygia!"
   },
   "Keys": [
    {
     "Key": "B308D1F04AE6C01A48DDC3883B4FC3BB",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "You are rats clutching debris. We are empire!"
   },
   "Keys": [
    {
     "Key": "BEA779AB4B14A8DA4041F58438A860C7",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Death is too good for you dogs, but I am generous!"
   },
   "Keys": [
    {
     "Key": "B0038A14429EB3761CA6BE87FB0A34D9",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Why struggle? It is already over."
   },
   "Keys": [
    {
     "Key": "341F700247901788DA5D7DB9832AC996",
     "Path": ""
    }
   ]
  },
  {
   "Source": {
    "Text": "Kneel! Beg to be one of my thralls!"
   },
   "Keys": [
    {
     "Key": "E8D7BDA6414277196EDBB2B204AA693E",
     "Path": ""
    }
   ]
  },
