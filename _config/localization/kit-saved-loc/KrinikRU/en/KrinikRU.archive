  },
  {
   "Source": {
    "Text": "Ymir's Stormshield"
   },
   "Translation": {
    "Text": "Ymir's Stormshield"
   },
   "Key": "ItemTable_Ymirs_Respite_77012405_Name"
  },
  {
   "Source": {
    "Text": "A shield imbued with storm powers of Ymir."
   },
   "Translation": {
    "Text": "A shield imbued with storm powers of Ymir."
   },
   "Key": "ItemTable_Ymirs_Respite_77012405_ShortDesc"
  },
  {
   "Source": {
    "Text": "The surface of this shield seems to glow with a strange luminescence hinting at the stormgod's power. Although lighter than a normal shield, it seems well fit for a frost giant's defense."
   },
   "Translation": {
    "Text": "The surface of this shield seems to glow with a strange luminescence hinting at the stormgod's power. Although lighter than a normal shield, it seems well fit for a frost giant's defense."
   },
   "Key": "ItemTable_Ymirs_Respite_77012405_LongDesc"
