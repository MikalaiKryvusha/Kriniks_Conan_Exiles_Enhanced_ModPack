  {
   "Source": {
    "Text": "Next attack(s) are empowered with Astral damage and restore stamina."
   },
   "Translation": {
    "Text": "Next attack(s) are empowered with Astral damage and restore stamina."
   },
   "Key": "0084BB214BD1F1A4D11419853D2DFA81"
  },
  {
   "Source": {
    "Text": "Indulgence"
   },
   "Translation": {
    "Text": "Indulgence"
   },
   "Key": "C128541545A4CEACB9629AB38524127F"
  },
  {
   "Source": {
    "Text": "Salacity"
   },
   "Translation": {
    "Text": "Salacity"
   },
   "Key": "14F6A659428957FF2B2460A93971D9D9"
  },
  {
   "Source": {
    "Text": "Spending stamina causes your attacks to deal bonus Astral damage and heal you. Becoming exhausted consumes the bonus and lowers defenses."
   },
   "Translation": {
    "Text": "Spending stamina causes your attacks to deal bonus Astral damage and heal you. Becoming exhausted consumes the bonus and lowers defenses."
   },
   "Key": "1AE14CCF43AC3477B22934BEA37F29EF"
  },
  {
   "Source": {
    "Text": "Derketan Salacity"
   },
   "Translation": {
    "Text": "Derketan Salacity"
   },
   "Key": "52B35958412703BE3F00098814A4620A"
  },
  {
   "Source": {
    "Text": "Your attacks cause Astral damage over time on the target. Thralls of the opposite sex who are following you can consume this effect to heal and empower your attacks."
   },
   "Translation": {
    "Text": "Your attacks cause Astral damage over time on the target. Thralls of the opposite sex who are following you can consume this effect to heal and empower your attacks."
   },
   "Key": "FBF77D0749D1D9BF62E01CBB4C90FB77"
  },
  {
   "Source": {
    "Text": "Ecstatic Duet"
   },
   "Translation": {
