  {
   "Source": {
    "Text": "Set's Divine Fang"
   },
   "Translation": {
    "Text": "Set's Divine Fang"
   },
   "Key": "Caverns_of_Set_Item_Table_77991104_Name"
  },
  {
   "Source": {
    "Text": "A handcrafted bow blessed by the Old Serpent to use a highly specialized ammunition."
   },
   "Translation": {
    "Text": "A handcrafted bow blessed by the Old Serpent to use a highly specialized ammunition."
   },
   "Key": "Caverns_of_Set_Item_Table_77991104_ShortDesc"
  },
  {
   "Source": {
    "Text": "Typically used as a decorative weapon for special Setite sacrificial cerimonies, this bow hides an additional purpose - knocking out victims at great distance."
   },
   "Translation": {
    "Text": "Typically used as a decorative weapon for special Setite sacrificial cerimonies, this bow hides an additional purpose - knocking out victims at great distance."
   },
   "Key": "Caverns_of_Set_Item_Table_77991104_LongDesc"
  },
