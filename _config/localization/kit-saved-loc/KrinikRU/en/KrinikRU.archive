  {
   "Source": {
    "Text": "Dragon Slayer Ultra Greatsword"
   },
   "Translation": {
    "Text": "Dragon Slayer Ultra Greatsword"
   },
   "Key": "HA_ItemTable_2492228_Name"
  },
  {
   "Source": {
    "Text": "A massive two handed sword imbued with Lightning Infused & Withering"
   },
   "Translation": {
    "Text": "A massive two handed sword imbued with Lightning Infused & Withering"
   },
   "Key": "HA_ItemTable_2492228_ShortDesc"
  },
  {
   "Source": {
    "Text": "It was too big to be called a sword. Massive, thick, heavy, and far too rough. Indeed, it was a heap of raw iron. Commissioned by Kali."
   },
   "Translation": {
    "Text": "It was too big to be called a sword. Massive, thick, heavy, and far too rough. Indeed, it was a heap of raw iron. Commissioned by Kali."
   },
   "Key": "HA_ItemTable_2492228_LongDesc"
