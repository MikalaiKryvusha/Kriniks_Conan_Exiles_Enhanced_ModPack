  {
   "Source": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Translation": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Key": "DT_EAA_Itemtable_5545248_ShortDesc"
  },
  {
   "Source": {
    "Text": "These swords have been perfectly balanced for the purpose of wielding both of them at the same time, sacrificing defense in favor of a flurry of blows being rained down on your opponent."
   },
   "Translation": {
    "Text": "These swords have been perfectly balanced for the purpose of wielding both of them at the same time, sacrificing defense in favor of a flurry of blows being rained down on your opponent."
   },
   "Key": "DT_EAA_Itemtable_5545248_LongDesc"
