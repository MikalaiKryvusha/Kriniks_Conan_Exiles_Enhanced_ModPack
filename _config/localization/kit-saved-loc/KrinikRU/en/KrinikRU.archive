  },
  {
   "Source": {
    "Text": "Debauchery"
   },
   "Translation": {
    "Text": "Debauchery"
   },
   "Key": "ODO_ItemTable_Add_18303_ThirdModifier"
  },
  {
   "Source": {
    "Text": "Honeyed Dates of Derketo"
   },
   "Translation": {
    "Text": "Honeyed Dates of Derketo"
   },
   "Key": "ODO_ItemTable_Add_47210128_Name"
  },
  {
   "Source": {
    "Text": "A tasty treat for your faithful"
   },
   "Translation": {
    "Text": "A tasty treat for your faithful"
   },
   "Key": "ODO_ItemTable_Add_47210128_ShortDesc"
  },
  {
   "Source": {
    "Text": "Said to be the fruit of Derketo's personal domain, this sweet fruit is an ideal reward and motivator to those in your service. What you don't tell them is that the fruit is blessed to compel further obedience and submission from them. A servant who is fed these special dates will come to view their Master or Mistress with an overwhelming lustful desire that inspires effort beyond their normal ability in the silent hope of being chosen for the bed chambers.\r\n\r\n<LoreItalics>When fed to thralls, grants them +20% strength and agility weapon damage and +300 armor for 1 hour. Counts as an elixir buff.</>"
   },
   "Translation": {
    "Text": "Said to be the fruit of Derketo's personal domain, this sweet fruit is an ideal reward and motivator to those in your service. What you don't tell them is that the fruit is blessed to compel further obedience and submission from them. A servant who is fed these special dates will come to view their Master or Mistress with an overwhelming lustful desire that inspires effort beyond their normal ability in the silent hope of being chosen for the bed chambers.\r\n\r\n<LoreItalics>When fed to thralls, grants them +20% strength and agility weapon damage and +300 armor for 1 hour. Counts as an elixir buff.</>"
   },
   "Key": "ODO_ItemTable_Add_47210128_LongDesc"
  },
  {
   "Source": {
    "Text": "Hallowed"
   },
   "Translation": {
    "Text": "Hallowed"
   },
   "Key": "ODO_ItemTable_Add_47210128_FirstModifier"
  },
