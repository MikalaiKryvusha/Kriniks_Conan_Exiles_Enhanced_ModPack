  },
  {
   "Source": {
    "Text": "Virtuous Mitraen Shoes"
   },
   "Translation": {
    "Text": "Virtuous Mitraen Shoes"
   },
   "Key": "LegitReligiousItemTable_6952525_Name"
  },
  {
   "Source": {
    "Text": "A simple pair of shoes"
   },
   "Translation": {
    "Text": "A simple pair of shoes"
   },
   "Key": "LegitReligiousItemTable_6952525_ShortDesc"
  },
  {
   "Source": {
    "Text": "Followers of Mitra commit to a life of simplicty and dignity. They prefer knowledge to ritual and the calm of meditation to the storm of battle.\nThese shoes reflects the simple principles of the Mitraen devout.\n"
   },
   "Translation": {
    "Text": "Followers of Mitra commit to a life of simplicty and dignity. They prefer knowledge to ritual and the calm of meditation to the storm of battle.\nThese shoes reflects the simple principles of the Mitraen devout.\n"
   },
   "Key": "LegitReligiousItemTable_6952525_LongDesc"
  },
