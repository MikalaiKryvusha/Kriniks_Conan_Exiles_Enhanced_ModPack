   "Key": "44CC6AA84706130038202F88E51088A2"
  },
  {
   "Source": {
    "Text": "Food buff potency: strength of the stat bonuses given by the fish dishes and feasts of this mod. 100 % = unchanged, 50 % = half, 0 % = no bonus. Applies from the next dish eaten; item descriptions keep showing the base values."
   },
   "Translation": {
    "Text": "Food buff potency: strength of the stat bonuses given by the fish dishes and feasts of this mod. 100 % = unchanged, 50 % = half, 0 % = no bonus. Applies from the next dish eaten; item descriptions keep showing the base values."
   },
   "Key": "AECA59A94303E35C5D412B95820BC1A2"
  },
  {
   "Source": {
    "Text": "Reset to Vanilla. Press Apply to send it to the server."
   },
   "Translation": {
    "Text": "Reset to Vanilla. Press Apply to send it to the server."
   },
   "Key": "027113AB46A587E1A06812AF64C9157A"
  },
  {
   "Source": {
    "Text": "Sent to the server. Every player receives the new settings right away."
   },
   "Translation": {
    "Text": "Sent to the server. Every player receives the new settings right away."
   },
   "Key": "A2D0416B40542CB613325D8FC9B4D995"
  },
  {
   "Source": {
    "Text": "Profile loaded into the panel. Press Apply to send it to the server."
   },
   "Translation": {
    "Text": "Profile loaded into the panel. Press Apply to send it to the server."
   },
   "Key": "31531FCF44103E0CA0BC0BBA39C00A04"
  },
  {
   "Source": {
    "Text": "This profile slot is empty."
   },
   "Translation": {
    "Text": "This profile slot is empty."
   },
   "Key": "B8E871894468566ECC4A19B720DA0320"
  },
  {
   "Source": {
    "Text": "Profile saved on the server (the settings shown in this panel)."
   },
   "Translation": {
    "Text": "Profile saved on the server (the settings shown in this panel)."
   },
   "Key": "AED71B2B4C45DA33054F9DB475A00575"
  },
  {
   "Source": {
    "Text": "Profile deleted on the server."
   },
   "Translation": {
    "Text": "Profile deleted on the server."
   },
   "Key": "0F02D2C84E4BC41B28F93F8F0AA184DC"
  },
  {
   "Source": {
    "Text": "Overall difficulty for every player. Vanilla = the original game. Easy = more fish of the player's own level; rare fish stay rare."
   },
   "Translation": {
    "Text": "Overall difficulty for every player. Vanilla = the original game. Easy = more fish of the player's own level; rare fish stay rare."
   },
   "Key": "5D5A43FB452568B2FD36D89FB651E9BB"
  },
  {
   "Source": {
    "Text": "Custom: edit the drop weight of each fish in the list, on top of the difficulty chosen here. Higher = more frequent, 0 = never caught. Click again to go back to the plain difficulty."
   },
   "Translation": {
    "Text": "Custom: edit the drop weight of each fish in the list, on top of the difficulty chosen here. Higher = more frequent, 0 = never caught. Click again to go back to the plain difficulty."
   },
   "Key": "7472085C4EC75ADF63BFC1B6C66F7156"
  },
  {
   "Source": {
    "Text": "Catch focus: boosts fish whose required Fishing Power is close to the player's, at the expense of fish far below it (junk, low tiers). 0 = vanilla odds."
   },
   "Translation": {
    "Text": "Catch focus: boosts fish whose required Fishing Power is close to the player's, at the expense of fish far below it (junk, low tiers). 0 = vanilla odds."
   },
   "Key": "37AFDA5849609DEF8EBD6788EF98B5B6"
  },
  {
   "Source": {
    "Text": "Level tolerance: width of the at-level window. Low = only fish very close to the player's Fishing Power are boosted. High = a wider range."
   },
   "Translation": {
    "Text": "Level tolerance: width of the at-level window. Low = only fish very close to the player's Fishing Power are boosted. High = a wider range."
   },
   "Key": "F6E8D3B54368AEFE80036588480D46D8"
  },
  {
   "Source": {
    "Text": "Mythic (T7) rarity: multiplier on Mythic fish only (inside their time window). 1 = unchanged, 0.5 = half as often."
   },
   "Translation": {
    "Text": "Mythic (T7) rarity: multiplier on Mythic fish only (inside their time window). 1 = unchanged, 0.5 = half as often."
   },
   "Key": "C4801BE5401C76F0FBCFE2A5501A397A"
  },
  {
   "Source": {
    "Text": "Bite wait: multiplies the wait before a bite. 0.5 = twice as fast. 1 = vanilla."
   },
   "Translation": {
    "Text": "Bite wait: multiplies the wait before a bite. 0.5 = twice as fast. 1 = vanilla."
   },
   "Key": "49CD65064309ECDDEDCEEDA3C18D86EC"
  },
  {
   "Source": {
    "Text": "Fight difficulty: difficulty of the catch mini-game. Below 1 = easier fights."
   },
   "Translation": {
    "Text": "Fight difficulty: difficulty of the catch mini-game. Below 1 = easier fights."
   },
   "Key": "59B86E66421C77D33273D487139F5C75"
  },
  {
   "Source": {
    "Text": "Fish speed: how fast the fish moves in the mini-game. Below 1 = slower."
   },
   "Translation": {
    "Text": "Fish speed: how fast the fish moves in the mini-game. Below 1 = slower."
   },
   "Key": "A5BD4B3948BC9301E011098F4EDAF2E8"
  },
  {
   "Source": {
    "Text": "Catch zone: size of the catch zone in the mini-game. Above 1 = bigger, easier."
   },
   "Translation": {
    "Text": "Catch zone: size of the catch zone in the mini-game. Above 1 = bigger, easier."
   },
   "Key": "CB17B3C04730200D32B4C8AF996F867D"
  },
  {
   "Source": {
    "Text": "Fishing Power of the test fisher used by the simulator."
   },
   "Translation": {
    "Text": "Fishing Power of the test fisher used by the simulator."
   },
   "Key": "B24BA40448DFE17C33FABD91B9AD7799"
  },
  {
   "Source": {
    "Text": "Biome where the test fisher is fishing."
   },
   "Translation": {
    "Text": "Biome where the test fisher is fishing."
   },
   "Key": "A13496C04763288D68AD44AFFE70A0DB"
