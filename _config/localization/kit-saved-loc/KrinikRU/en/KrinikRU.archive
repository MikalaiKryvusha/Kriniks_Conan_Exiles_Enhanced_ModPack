  },
  {
   "Source": {
    "Text": "Ancient Civ Gate"
   },
   "Translation": {
    "Text": "Ancient Civ Gate"
   },
   "Key": "Ancient_Civ_ItemTable3790361_Name"
  },
  {
   "Source": {
    "Text": "Sturdy doors to keep enemies at bay"
   },
   "Translation": {
    "Text": "Sturdy doors to keep enemies at bay"
   },
   "Key": "Ancient_Civ_ItemTable3790361_ShortDesc"
  },
