  {
   "Source": {
    "Text": "Tavern Bar"
   },
   "Translation": {
    "Text": "Tavern Bar"
   },
   "Key": "Core_ItemTable_210217_Name"
  },
  {
   "Source": {
    "Text": "A Bar with a counter for serving guests, and cabinets for storage"
   },
   "Translation": {
    "Text": "A Bar with a counter for serving guests, and cabinets for storage"
   },
   "Key": "Core_ItemTable_210217_ShortDesc"
  },
  {
   "Source": {
    "Text": "The counter at which drinks are served by a bartender is called \"the bar\". This term is applied, as a synecdoche, to drinking establishments called \"bars\". This counter typically stores a variety of beers, wines, liquors, and non-alcoholic ingredients, and is organized to facilitate the bartender's work."
   },
   "Translation": {
    "Text": "The counter at which drinks are served by a bartender is called \"the bar\". This term is applied, as a synecdoche, to drinking establishments called \"bars\". This counter typically stores a variety of beers, wines, liquors, and non-alcoholic ingredients, and is organized to facilitate the bartender's work."
   },
   "Key": "Core_ItemTable_210217_LongDesc"
  },
