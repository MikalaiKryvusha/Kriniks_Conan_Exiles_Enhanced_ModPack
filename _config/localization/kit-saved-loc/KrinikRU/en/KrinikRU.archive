  {
   "Source": {
    "Text": "Sword of the Grey Ancients"
   },
   "Translation": {
    "Text": "Sword of the Grey Ancients"
   },
   "Key": "Caverns_of_Set_Item_Table_77991108_Name"
  },
  {
   "Source": {
    "Text": "A sword made in imitation of the ancient Grey Ones"
   },
   "Translation": {
    "Text": "A sword made in imitation of the ancient Grey Ones"
   },
   "Key": "Caverns_of_Set_Item_Table_77991108_ShortDesc"
  },
  {
   "Source": {
    "Text": "This sword is clearly made by human hands in imitation of the bizarre growths and alien materials that cover the strange beings known as the Grey Ones.\n\nSwords are straight-bladed, one-handed weapons, both fast and reliable."
   },
   "Translation": {
    "Text": "This sword is clearly made by human hands in imitation of the bizarre growths and alien materials that cover the strange beings known as the Grey Ones.\n\nSwords are straight-bladed, one-handed weapons, both fast and reliable."
   },
