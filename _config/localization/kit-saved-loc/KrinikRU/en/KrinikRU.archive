   "Key": "DT_Fishing_ItemTable_389339_Name"
  },
  {
   "Source": {
    "Text": "A shared feast of old river ways. Lasts 20 minutes when placed."
   },
   "Translation": {
    "Text": "A shared feast of old river ways. Lasts 20 minutes when placed."
