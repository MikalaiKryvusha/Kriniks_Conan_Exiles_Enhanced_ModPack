   },
   "Key": "dt_Horti_ItemTableRow_5102110_Name"
  },
  {
   "Source": {
    "Text": "A bunch of grapes"
   },
   "Translation": {
    "Text": "A bunch of grapes"
   },
   "Key": "dt_Horti_ItemTableRow_5102110_ShortDesc"
  },
  {
   "Source": {
    "Text": "Low Grade"
   },
   "Translation": {
    "Text": "Low Grade"
   },
   "Key": "dt_Horti_ItemTableRow_5102110_FirstModifier"
  },
