   },
   "Translation": {
    "Text": "Compost Heap"
   },
   "Key": "ItemTable_18519_Name"
  },
  {
   "Source": {
    "Text": "A smelly pile of rotting matter"
   },
   "Translation": {
    "Text": "A smelly pile of rotting matter"
   },
   "Key": "ItemTable_18519_ShortDesc"
  },
  {
   "Source": {
    "Text": "Ask not a man what goes into his compost heap. That is his business alone. It is what a man removes from his compost heap that matters."
   },
   "Translation": {
    "Text": "Ask not a man what goes into his compost heap. That is his business alone. It is what a man removes from his compost heap that matters."
   },
   "Key": "ItemTable_18519_LongDesc"
