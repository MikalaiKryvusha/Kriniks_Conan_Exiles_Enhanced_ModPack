  },
  {
   "Source": {
    "Text": "Demon Bone"
   },
   "Translation": {
    "Text": "Demon Bone"
   },
   "Key": "DT_NightTerrors_ItemTable_101344690_Name"
  },
  {
   "Source": {
    "Text": "Bones rife with the foul blight of the hells"
   },
   "Translation": {
    "Text": "Bones rife with the foul blight of the hells"
   },
   "Key": "DT_NightTerrors_ItemTable_101344690_ShortDesc"
  },
  {
   "Source": {
    "Text": "These bones emenate great evil and remain hot to the touch..\n"
   },
   "Translation": {
    "Text": "These bones emenate great evil and remain hot to the touch..\n"
   },
   "Key": "DT_NightTerrors_ItemTable_101344690_LongDesc"
  },
  {
   "Source": {
    "Text": "Demon Essence"
   },
   "Translation": {
    "Text": "Demon Essence"
   },
   "Key": "DT_NightTerrors_ItemTable_101344691_Name"
  },
  {
   "Source": {
    "Text": "This unearthly substance defies description."
   },
   "Translation": {
    "Text": "This unearthly substance defies description."
   },
   "Key": "DT_NightTerrors_ItemTable_101344691_ShortDesc"
  },
  {
   "Source": {
    "Text": "Taken from a demonic entity that was out of place in this reality, this object defies simple description. It seems to struggle against classification, an unstable form that ripples against the very fabric of time and space."
   },
   "Translation": {
    "Text": "Taken from a demonic entity that was out of place in this reality, this object defies simple description. It seems to struggle against classification, an unstable form that ripples against the very fabric of time and space."
   },
   "Key": "DT_NightTerrors_ItemTable_101344691_LongDesc"
  },
  {
   "Source": {
    "Text": "Sigil of Minevra"
   },
   "Translation": {
    "Text": "Sigil of Minevra"
   },
   "Key": "DT_NightTerrors_ItemTable_101344692_Name"
  },
  {
   "Source": {
    "Text": "A symbol of the demon queen Minevra, the Pale Mother"
   },
   "Translation": {
    "Text": "A symbol of the demon queen Minevra, the Pale Mother"
   },
   "Key": "DT_NightTerrors_ItemTable_101344692_ShortDesc"
  },
  {
   "Source": {
    "Text": "Hellforge Steel"
   },
   "Translation": {
    "Text": "Hellforge Steel"
   },
   "Key": "DT_NightTerrors_ItemTable_101344693_Name"
  },
  {
   "Source": {
    "Text": "An alloy created from some mysterious unknown ore"
   },
   "Translation": {
    "Text": "An alloy created from some mysterious unknown ore"
   },
   "Key": "DT_NightTerrors_ItemTable_101344693_ShortDesc"
  },
  {
   "Source": {
    "Text": "This forged ingot seems to put thoughts in the mind when touched and emanates unsettling feelings.\n\nAll of this aside, it seems impossible to work and will require someone with more knowledge to craft with."
   },
   "Translation": {
    "Text": "This forged ingot seems to put thoughts in the mind when touched and emanates unsettling feelings.\n\nAll of this aside, it seems impossible to work and will require someone with more knowledge to craft with."
   },
   "Key": "DT_NightTerrors_ItemTable_101344693_LongDesc"
  },
  {
   "Source": {
    "Text": "Swords crafted from a dull, grey metal, radiating intense heat, and balanced for dual wielding. "
   },
   "Translation": {
    "Text": "Swords crafted from a dull, grey metal, radiating intense heat, and balanced for dual wielding. "
   },
   "Key": "DT_NightTerrors_RecipesTable_101344600_ShortDesc"
  },
  {
   "Source": {
    "Text": "A two-handed sword crafted from a dull, grey metal that radiates with intense heat."
   },
   "Translation": {
    "Text": "A two-handed sword crafted from a dull, grey metal that radiates with intense heat."
   },
   "Key": "DT_NightTerrors_RecipesTable_101344601_ShortDesc"
  },
