  {
   "Source": {
    "Text": "A two-handed sweeping warspear imbued with Frostburn & Empowering Assault"
   },
   "Translation": {
    "Text": "A two-handed sweeping warspear imbued with Frostburn & Empowering Assault"
   },
   "Key": "HA_ItemTable_2491792_ShortDesc"
  },
  {
   "Source": {
    "Text": "This spear is favored by many warriors whom live in the biting cold of the north. The blade feels cold to the touch as if it were made from ice. Commissioned by SkyTheGuy."
   },
   "Translation": {
    "Text": "This spear is favored by many warriors whom live in the biting cold of the north. The blade feels cold to the touch as if it were made from ice. Commissioned by SkyTheGuy."
