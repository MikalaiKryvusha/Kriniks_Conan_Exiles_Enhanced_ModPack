   "Key": "HA_ItemTable_2492229_Name"
  },
  {
   "Source": {
    "Text": "One-handed short spear imbued with Cleansing & Withering Strikes"
   },
   "Translation": {
    "Text": "One-handed short spear imbued with Cleansing & Withering Strikes"
   },
   "Key": "HA_ItemTable_2492229_ShortDesc"
  },
  {
   "Source": {
    "Text": "The three prongs of the trishula are often interpreted as representing various trinities, such as creation, preservation, and destruction, or past, present, and future. Commissioned by Kali."
   },
   "Translation": {
    "Text": "The three prongs of the trishula are often interpreted as representing various trinities, such as creation, preservation, and destruction, or past, present, and future. Commissioned by Kali."
