   },
   "Key": "C836FD464E855812914A3D986C1A9335"
  },
  {
   "Source": {
    "Text": "Maximum Spawn Distance:"
   },
   "Translation": {
    "Text": "Maximum Spawn Distance:"
   },
   "Key": "8D5E0FF0453C836D6AAABE9096069AC6"
  },
  {
