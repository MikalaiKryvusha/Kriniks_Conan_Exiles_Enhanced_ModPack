  {
   "Source": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Translation": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Key": "DT_EAA_Itemtable_5545889_ShortDesc"
  },
  {
   "Source": {
    "Text": "These swords have been perfectly balanced for the purpose of wielding both of them at the same time, sacrificing defense in favor of a flurry of blows being rained down on your opponent."
   },
   "Translation": {
    "Text": "These swords have been perfectly balanced for the purpose of wielding both of them at the same time, sacrificing defense in favor of a flurry of blows being rained down on your opponent."
   },
   "Key": "DT_EAA_Itemtable_5545889_LongDesc"
  },
  {
   "Source": {
    "Text": "Enhanced Armory & Arsenal"
   },
   "Translation": {
    "Text": "Enhanced Armory & Arsenal"
   },
   "Key": "DT_EAA_Itemtable_5545889_FirstModifier"
  },
  {
   "Source": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Translation": {
    "Text": "A weapon made of mysterious necrotic steel"
   },
   "Key": "DT_EAA_Itemtable_5545890_ShortDesc"
  },
  {
   "Source": {
    "Text": "This weapon is forged in the style of ancient Acheron, a kingdom of sorcerers that dominated the northern kingdoms over three thousand years ago. Scholars have noted that the Acheronian style bears a striking similarity to that of the mysterious pre-human race that once ruled what is modern-day Stygia."
   },
   "Translation": {
    "Text": "This weapon is forged in the style of ancient Acheron, a kingdom of sorcerers that dominated the northern kingdoms over three thousand years ago. Scholars have noted that the Acheronian style bears a striking similarity to that of the mysterious pre-human race that once ruled what is modern-day Stygia."
   },
   "Key": "DT_EAA_Itemtable_5545890_LongDesc"
