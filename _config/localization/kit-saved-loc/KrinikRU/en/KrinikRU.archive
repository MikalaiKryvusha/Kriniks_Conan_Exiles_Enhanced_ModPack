   "Key": "ItemTable_51391_Name"
  },
  {
   "Source": {
    "Text": "A bow from the collection of the Priest King"
   },
   "Translation": {
    "Text": "A bow from the collection of the Priest King"
   },
   "Key": "ItemTable_51391_ShortDesc"
  },
  {
   "Source": {
    "Text": "A religious item inscribed with holy runes, this relic was wrested from the undead hands of the Priest King's shade. While very accurate, this bow fires arrows with less speed than other bows, making the arrow penetrate less armor when it hits."
   },
   "Translation": {
    "Text": "A religious item inscribed with holy runes, this relic was wrested from the undead hands of the Priest King's shade. While very accurate, this bow fires arrows with less speed than other bows, making the arrow penetrate less armor when it hits."
   },
   "Key": "ItemTable_51391_LongDesc"
