   "Key": "769DDDFC439B5D7F2A624EBFBDAD7D5D"
  },
  {
   "Source": {
    "Text": "Your attacks often inflict Sibilant Poison, an Entropic poison that self-stacks and becomes more dangerous as it grows."
   },
   "Translation": {
    "Text": "Your attacks often inflict Sibilant Poison, an Entropic poison that self-stacks and becomes more dangerous as it grows."
   },
   "Key": "E4A406B445D13891A97F0D890147C675"
  },
  {
   "Source": {
    "Text": "Sibilant Poison"
   },
   "Translation": {
    "Text": "Sibilant Poison"
   },
   "Key": "A042956A47DBEE56F05F34A265A32F62"
  },
  {
   "Source": {
    "Text": "When you take damage, you can gain Resolve, healing YOU over 8 seconds and causing your next attack to apply Rime. Rime deals Primal air damage over 16 seconds and cripples the target for that time."
   },
   "Translation": {
    "Text": "When you take damage, you can gain Resolve, healing YOU over 8 seconds and causing your next attack to apply Rime. Rime deals Primal air damage over 16 seconds and cripples the target for that time."
   },
   "Key": "7E1D903D489E2824857AD49FB3E4D7BC"
  },
  {
   "Source": {
    "Text": "Ymir's Resolve"
   },
   "Translation": {
    "Text": "Ymir's Resolve"
   },
   "Key": "DCA020404CF375A2E1092A9AA8B4368A"
  },
  {
   "Source": {
    "Text": "Your attacks grant Frost Fracture for 12 seconds, stacking up to 10 times. Kicking consumes all Frost Fracture to deal Primal cold damage per stack to enemies in a line in front of you."
   },
   "Translation": {
    "Text": "Your attacks grant Frost Fracture for 12 seconds, stacking up to 10 times. Kicking consumes all Frost Fracture to deal Primal cold damage per stack to enemies in a line in front of you."
   },
   "Key": "2929893E49415ED833F6B499D166061D"
  },
