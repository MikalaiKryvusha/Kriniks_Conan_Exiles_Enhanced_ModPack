   "Source": {
    "Text": "Painting - Jutting Skull"
   },
   "Translation": {
    "Text": "Painting - Jutting Skull"
   },
   "Key": "HA_ItemTable_2492210_Name"
  },
  {
   "Source": {
    "Text": "A framed painting of distant memories"
   },
   "Translation": {
    "Text": "A framed painting of distant memories"
   },
   "Key": "HA_ItemTable_2492210_ShortDesc"
  },
  {
   "Source": {
    "Text": "Talented artists are few and far between but the fact that even in the Exiled Lands, art such as this survives and thrives is comforting. Amongst all the bloodshed one can still appreciate the talent of the painter."
   },
   "Translation": {
    "Text": "Talented artists are few and far between but the fact that even in the Exiled Lands, art such as this survives and thrives is comforting. Amongst all the bloodshed one can still appreciate the talent of the painter."
   },
   "Key": "HA_ItemTable_2492210_LongDesc"
